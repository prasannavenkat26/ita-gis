# ─── API ───
# Vite proxies /api to the local FastAPI backend at 127.0.0.1:8000.

# ─── Optional: Map Provider ───
# If set, the app can use Google Maps JavaScript API with Drawing, Geometry, and Places.
# If not set, the app falls back to OpenStreetMap / Leaflet (free, no key needed).
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Optional: External Modules ───
# These are NOT required for core GIS functionality.
# Add them to enable weather, satellite, soil sensor, or IoT integrations.
# VITE_WEATHER_API_KEY=your_weather_api_key
# VITE_SATELLITE_API_KEY=your_satellite_api_key
# VITE_SOIL_SENSOR_API_KEY=your_soil_sensor_api_key
# VITE_IOT_API_KEY=your_iot_api_key

# ─── Backend-only (never expose in VITE_ variables) ───
# FARM_GIS_SECRET_KEY=generate-a-long-random-secret-for-production
# FARM_GIS_DB_PATH=backend/data/farm_gis.sqlite3
